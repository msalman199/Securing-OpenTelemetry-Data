Subtask 1.2: Create SSL/TLS Certificates
We'll create self-signed certificates for securing our OpenTelemetry communications.

# Create a directory for certificates
mkdir -p ~/otel-security/certs
cd ~/otel-security/certs

# Generate a private key for the Certificate Authority (CA)
openssl genrsa -out ca-key.pem 4096

# Create a CA certificate
openssl req -new -x509 -days 365 -key ca-key.pem -sha256 -out ca.pem -subj "/C=US/ST=CA/L=San Francisco/O=OpenTelemetry Lab/CN=otel-ca"

# Generate a private key for the server
openssl genrsa -out server-key.pem 4096

# Create a certificate signing request for the server
openssl req -subj "/C=US/ST=CA/L=San Francisco/O=OpenTelemetry Lab/CN=otel-collector" -sha256 -new -key server-key.pem -out server.csr

# Create extensions file for server certificate
cat > server-extfile.cnf << EOF
subjectAltName = DNS:otel-collector,DNS:localhost,IP:127.0.0.1,IP:0.0.0.0
extendedKeyUsage = serverAuth
EOF

# Generate the server certificate
openssl x509 -req -days 365 -sha256 -in server.csr -CA ca.pem -CAkey ca-key.pem -out server-cert.pem -extfile server-extfile.cnf -CAcreateserial

# Generate a private key for the client
openssl genrsa -out client-key.pem 4096

# Create a certificate signing request for the client
openssl req -subj "/C=US/ST=CA/L=San Francisco/O=OpenTelemetry Lab/CN=otel-client" -new -key client-key.pem -out client.csr

# Create extensions file for client certificate
cat > client-extfile.cnf << EOF
extendedKeyUsage = clientAuth
EOF

# Generate the client certificate
openssl x509 -req -days 365 -sha256 -in client.csr -CA ca.pem -CAkey ca-key.pem -out client-cert.pem -extfile client-extfile.cnf -CAcreateserial

# Set appropriate permissions
chmod 400 ca-key.pem server-key.pem client-key.pem
chmod 444 ca.pem server-cert.pem client-cert.pem

# Clean up temporary files
rm server.csr client.csr server-extfile.cnf client-extfile.cnf

# Verify certificates
echo "Verifying server certificate:"
openssl verify -CAfile ca.pem server-cert.pem

echo "Verifying client certificate:"
openssl verify -CAfile ca.pem client-cert.pem
Subtask 1.3: Configure Encrypted OpenTelemetry Collector
Now we'll set up an OpenTelemetry Collector with TLS encryption enabled.

# Create directory structure for the collector
cd ~/otel-security
mkdir -p collector/config

# Download OpenTelemetry Collector
wget https://github.com/open-telemetry/opentelemetry-collector-releases/releases/download/v0.89.0/otelcol_0.89.0_linux_amd64.tar.gz
tar -xzf otelcol_0.89.0_linux_amd64.tar.gz -C collector/
chmod +x collector/otelcol

# Create secure collector configuration
cat > collector/config/collector-secure.yaml << 'EOF'
receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
        tls:
          cert_file: /certs/server-cert.pem
          key_file: /certs/server-key.pem
          ca_file: /certs/ca.pem
          client_ca_file: /certs/ca.pem
      http:
        endpoint: 0.0.0.0:4318
        tls:
          cert_file: /certs/server-cert.pem
          key_file: /certs/server-key.pem
          ca_file: /certs/ca.pem
          client_ca_file: /certs/ca.pem

processors:
  batch:
    timeout: 1s
    send_batch_size: 1024
  
  # Add encryption processor for sensitive data
  attributes:
    actions:
      - key: sensitive_data
        action: hash

exporters:
  # Secure file exporter with encryption
  file:
    path: /data/encrypted-traces.json
    rotation:
      max_megabytes: 10
      max_days: 3
      max_backups: 3
  
  # Logging exporter for debugging
  logging:
    loglevel: info
    sampling_initial: 2
    sampling_thereafter: 500

service:
  pipelines:
    traces:
      receivers: [otlp]
      processors: [attributes, batch]
      exporters: [file, logging]
    
    metrics:
      receivers: [otlp]
      processors: [batch]
      exporters: [file, logging]
    
    logs:
      receivers: [otlp]
      processors: [batch]
      exporters: [file, logging]
  
  extensions: []
  
  telemetry:
    logs:
      level: info
    metrics:
      address: 127.0.0.1:8888
EOF

# Create data directory for encrypted storage
mkdir -p ~/otel-security/data

# Create a startup script for the secure collector
cat > collector/start-secure-collector.sh << 'EOF'
#!/bin/bash
cd "$(dirname "$0")"
./otelcol --config=config/collector-secure.yaml
EOF

