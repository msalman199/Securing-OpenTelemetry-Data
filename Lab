Subtask 2.2: Implement Network Security Measures
Let's configure additional network security measures.

# Create network security configuration
mkdir -p ~/otel-security/network

# Create iptables rules for OpenTelemetry security
cat > network/setup-firewall.sh << 'EOF'
#!/bin/bash

# Flush existing rules
sudo iptables -F
sudo iptables -X

# Set default policies
sudo iptables -P INPUT DROP
sudo iptables -P FORWARD DROP
sudo iptables -P OUTPUT ACCEPT

# Allow loopback traffic
sudo iptables -A INPUT -i lo -j ACCEPT
sudo iptables -A OUTPUT -o lo -j ACCEPT

# Allow established and related connections
sudo iptables -A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# Allow SSH (adjust port if needed)
sudo iptables -A INPUT -p tcp --dport 22 -j ACCEPT

# Allow OpenTelemetry ports only from localhost and specific networks
# OTLP gRPC port (4317)
sudo iptables -A INPUT -p tcp --dport 4317 -s 127.0.0.1 -j ACCEPT
sudo iptables -A INPUT -p tcp --dport 4317 -s 10.0.0.0/8 -j ACCEPT

# OTLP HTTP port (4318)
sudo iptables -A INPUT -p tcp --dport 4318 -s 127.0.0.1 -j ACCEPT
sudo iptables -A INPUT -p tcp --dport 4318 -s 10.0.0.0/8 -j ACCEPT

# Allow metrics endpoint (8888) only from localhost
sudo iptables -A INPUT -p tcp --dport 8888 -s 127.0.0.1 -j ACCEPT

# Log dropped packets
sudo iptables -A INPUT -j LOG --log-prefix "DROPPED: "

# Save rules (Ubuntu/Debian)
sudo iptables-save > /etc/iptables/rules.v4

echo "Firewall rules configured for OpenTelemetry security"
EOF

chmod +x network/setup-firewall.sh

# Create rate limiting configuration
cat > network/rate-limit.conf << 'EOF'
# Rate limiting configuration for OpenTelemetry endpoints

# Limit connections per IP
limit_conn_zone $binary_remote_addr zone=otel_conn:10m;
limit_conn otel_conn 10;

# Limit request rate
limit_req_zone $binary_remote_addr zone=otel_req:10m rate=100r/m;
limit_req zone=otel_req burst=20 nodelay;

# Configure upstream for load balancing
upstream otel_collectors {
    server 127.0.0.1:4317 max_fails=3 fail_timeout=30s;
    server 127.0.0.1:4318 max_fails=3 fail_timeout=30s backup;
}
EOF
Subtask 2.3: Set Up Secure Data Pipeline
Now let's create a complete secure data pipeline with monitoring.

# Create monitoring directory
mkdir -p ~/otel-security/monitoring

# Create a monitoring configuration
cat > monitoring/monitor-security.yaml << 'EOF'
receivers:
  # Monitor the collector itself
  prometheus:
    config:
      scrape_configs:
        - job_name: 'otel-collector'
          static_configs:
            - targets: ['localhost:8888']
          scrape_interval: 30s
          metrics_path: /metrics
          scheme: http

  # File log receiver for security logs
  filelog:
    include: ["/var/log/otel-security/*.log"]
    operators:
      - type: json_parser
        id: json_parser
        output: security_filter
      - type: filter
        id: security_filter
        expr: 'body.level == "ERROR" or body.level == "WARN"'

processors:
  batch:
    timeout: 30s
    send_batch_size: 512

  # Security-focused attribute processing
  attributes:
    actions:
      - key: security.event
        value: "telemetry_security_monitoring"
        action: insert
      - key: security.timestamp
        from_attribute: timestamp
        action: insert

exporters:
  # Security alerts file
  file/security:
    path: /data/security-alerts.json
    rotation:
      max_megabytes: 5
      max_days: 30

  logging:
    loglevel: info

service:
  pipelines:
    metrics:
      receivers: [prometheus]
      processors: [attributes, batch]
      exporters: [file/security, logging]
    
    logs:
      receivers: [filelog]
      processors: [attributes, batch]
      exporters: [file/security, logging]
EOF

# Create security monitoring script
cat > monitoring/security-monitor.sh << 'EOF'
#!/bin/bash

LOG_DIR="/var/log/otel-security"
DATA_DIR="$HOME/otel-security/data"

# Create log directory
sudo mkdir -p $LOG_DIR
sudo chown $USER:$USER $LOG_DIR

# Function to check certificate expiration
check_cert_expiration() {
    local cert_file=$1
    local days_until_expiry=$(openssl x509 -in "$cert_file" -noout -checkend $((30*24*3600)) && echo "OK" || echo "EXPIRING")
    
    if [ "$days_until_expiry" = "EXPIRING" ]; then
        echo "$(date): WARNING - Certificate $cert_file expires within 30 days" >> $LOG_DIR/security.log
    fi
}

# Function to monitor failed connections
monitor_connections() {
    local failed_connections=$(grep "connection refused\|handshake failure" $DATA_DIR/*.json 2>/dev/null | wc -l)
    
    if [ $failed_connections -gt 10 ]; then
        echo "$(date): ALERT - High number of failed connections detected: $failed_connections" >> $LOG_DIR/security.log
    fi
}

# Function to check for suspicious patterns
check_suspicious_activity() {
    local suspicious_patterns=("sql injection" "script injection" "path traversal" "buffer overflow")
    
    for pattern in "${suspicious_patterns[@]}"; do
        local count=$(grep -i "$pattern" $DATA_DIR/*.json 2>/dev/null | wc -l)
        if [ $count -gt 0 ]; then
            echo "$(date): SECURITY ALERT - Suspicious pattern detected: $pattern (count: $count)" >> $LOG_DIR/security.log
        fi
    done
}

# Main monitoring loop
while true; do
    # Check certificate expiration
    check_cert_expiration "$HOME/otel-security/certs/server-cert.pem"
    check_cert_expiration "$HOME/otel-security/certs/client-cert.pem"
    
    # Monitor connections
    monitor_connections
    
    # Check for suspicious activity
    check_suspicious_activity
    
    # Sleep for 5 minutes
    sleep 300
done
EOF

chmod +x monitoring/security-monitor.sh
